    clips = {
        dictionary default = {
            double2[] active = [(0, 0), (7, 1), (14, 2), (21, 3), (28, 4)]
            asset[] assetPaths = [@./chunk_0000.usda@, @./chunk_0001.usda@, @./chunk_0002.usda@, @./chunk_0003.usda@, @./chunk_0004.usda@]
            asset manifestAssetPath = @./run.manifest.usda@
            string primPath = "/World"
            double2[] times = [(0, 0), (6, 6), (7, 7), (13, 13), (14, 14), (20, 20), (21, 21), (27, 27), (28, 28), (29, 29)]
        }
    }
)
