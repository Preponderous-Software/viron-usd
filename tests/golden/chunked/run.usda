#usda 1.0
(
    customLayerData = {
        string "vironUsd:axisConvention" = "Viron x -> USD +X, Viron y -> USD +Y, Z up; one Viron cell = 1 unit; grids side by side along X ordered by grid id"
        int "vironUsd:environmentId" = 1
        string "vironUsd:version" = "0.1.0"
    }
    defaultPrim = "World"
    endTimeCode = 29
    framesPerSecond = 10
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./run.topology.usda@
    ]
    timeCodesPerSecond = 10
    upAxis = "Z"
)

