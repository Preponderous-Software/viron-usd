#usda 1.0

over "World"
{
    double viron:wallClock

    over "env_1"
    {
        over "entities"
        {
            over "e_1"
            {
                bool extras:alive
                double extras:energy
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate
            }

            over "e_2"
            {
                bool extras:alive
                double extras:energy
                string extras:mood
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate
            }

            over "e_3"
            {
                int extras:count
                double3 extras:heading
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate
            }

            over "e_4"
            {
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate

                over "geom"
                {
                    color3f[] primvars:displayColor = [(0.9, 0.70487976, 0.315)]
                }
            }

            over "e_5"
            {
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate
            }

            over "e_6"
            {
                int extras:count
                double3 extras:heading
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate
            }

            over "e_7"
            {
                string viron:name
                token visibility = "invisible"
                double3 xformOp:translate
            }
        }
    }
}

